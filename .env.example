# MittiMart Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# In local development mode, MittiMart runs with zero external dependencies using the embedded JSON/SQLite store.
# To connect your production MongoDB cluster, set USE_MONGODB=true and provide your connection URI:
USE_MONGODB=false
MONGODB_URI=mongodb://localhost:27017/mittimart
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mittimart?retryWrites=true&w=majority

# Security
JWT_SECRET=mittimart_super_secret_jwt_key_2026_unnat_kisan
TOKEN_EXPIRES_IN=7d

# Platform Fee Policy (As defined in Slide 11)
PLATFORM_FEE_PERCENTAGE=7.0
BASE_LOGISTICS_FEE=300
FARMER_COMMISSION_PERCENTAGE=0.0
